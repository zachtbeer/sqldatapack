<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      Unlike the test projects, the assembly name must match the .csproj file name: BenchmarkDotNet
      locates the project from the assembly name when it builds its generated boilerplate, and fails
      with "Unable to find <assembly> ... most probably the name of output exe is different than the
      name of the .csproj" when the two diverge. src/SqlDataPack/Properties/AssemblyInfo.cs grants
      InternalsVisibleTo to this exact name.
    -->
    <AssemblyName>SqlDataPack.Benchmarks</AssemblyName>
    <RootNamespace>SqlDataPack.Benchmarks</RootNamespace>
    <!--
      BenchmarkDotNet refuses to run a Debug build and needs an optimized, non-attached
      process; it also requires the server GC to be off for stable allocation numbers.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!--
      Deliberately no Microsoft.NET.Test.Sdk reference: `dotnet test SqlDataPack.slnx`
      only runs projects flagged as test projects, so the benchmarks build with the
      solution but never run as part of the test suite.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/SqlDataPack/SqlDataPack.csproj" />
  </ItemGroup>
</Project>
