root = true

[*]
indent_style = space
indent_size = 4
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 1000
guidelines = 1000

[*.{yml,yaml,json,md,sh}]
indent_size = 2

[*.{csproj,props,targets,config,nuspec,resx}]
indent_size = 2

[*.md]
# Trailing double-space is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.cs]

#### Enforced ####

dotnet_diagnostic.IDE0005.severity = warning        # unnecessary using directive

# Usings sit outside the namespace; file-scoped namespaces.
csharp_using_directive_placement = outside_namespace:warning
csharp_style_namespace_declarations = file_scoped:warning

# Braces always, even on single statements.
csharp_prefer_braces = true:warning

dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_preferred_modifier_order = public,private,protected,internal,file,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,required,volatile,async:warning

# No `this.` qualification.
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Language keywords over BCL type names (`int`, not `Int32`).
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# Non-default formatting; the rest of the formatting rules are Roslyn defaults.
csharp_indent_case_contents_when_block = false

#### Editor hints ####

# `var` where the right-hand side makes the type obvious.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expression bodies for one-line members, blocks elsewhere.
csharp_style_expression_bodied_methods = false:suggestion
csharp_style_expression_bodied_operators = when_on_single_line:suggestion
csharp_style_expression_bodied_local_functions = when_on_single_line:suggestion
csharp_style_expression_bodied_constructors = false:suggestion

csharp_style_prefer_primary_constructors = false:suggestion
dotnet_code_quality_unused_parameters = non_public:suggestion
dotnet_style_namespace_match_folder = false:silent

#### Naming ####

# Parameters are deliberately unruled: public model record constructors take PascalCase
# parameter names, and those names are public API.
dotnet_diagnostic.IDE1006.severity = warning        # naming rule violation

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.i_prefixed_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_prefixed_pascal_case.required_prefix = I
dotnet_naming_style.t_prefixed_pascal_case.capitalization = pascal_case
dotnet_naming_style.t_prefixed_pascal_case.required_prefix = T

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_rule.interfaces_are_i_prefixed.symbols = interfaces
dotnet_naming_rule.interfaces_are_i_prefixed.style = i_prefixed_pascal_case
dotnet_naming_rule.interfaces_are_i_prefixed.severity = warning

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter
dotnet_naming_rule.type_parameters_are_t_prefixed.symbols = type_parameters
dotnet_naming_rule.type_parameters_are_t_prefixed.style = t_prefixed_pascal_case
dotnet_naming_rule.type_parameters_are_t_prefixed.severity = warning

dotnet_naming_symbols.types_and_members.applicable_kinds = namespace,class,struct,enum,delegate,property,method,event,field,local_function
dotnet_naming_symbols.types_and_members.applicable_accessibilities = public,internal,protected,protected_internal,private_protected
dotnet_naming_rule.types_and_members_are_pascal_case.symbols = types_and_members
dotnet_naming_rule.types_and_members_are_pascal_case.style = pascal_case
dotnet_naming_rule.types_and_members_are_pascal_case.severity = warning

# Private static fields are PascalCase.
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private
dotnet_naming_symbols.private_static_fields.required_modifiers = static
dotnet_naming_rule.private_static_fields_are_pascal_case.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.private_static_fields_are_pascal_case.severity = warning

dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_rule.constants_are_pascal_case.symbols = constants
dotnet_naming_rule.constants_are_pascal_case.style = pascal_case
dotnet_naming_rule.constants_are_pascal_case.severity = warning

# Private instance fields are _camelCase.
dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private
dotnet_naming_rule.private_instance_fields_are_underscore_camel_case.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_instance_fields_are_underscore_camel_case.severity = warning

dotnet_naming_symbols.locals.applicable_kinds = local
dotnet_naming_rule.locals_are_camel_case.symbols = locals
dotnet_naming_rule.locals_are_camel_case.style = camel_case
dotnet_naming_rule.locals_are_camel_case.severity = warning

#### Brace and line placement ####

# K&R openings (`void Foo() {`), but `else`/`catch`/`finally` start their own line.
csharp_new_line_before_open_brace = none
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# ReSharper spells brace placement per construct rather than as one switch.
resharper_csharp_type_declaration_braces = end_of_line
resharper_csharp_invocable_declaration_braces = end_of_line
resharper_csharp_anonymous_method_declaration_braces = end_of_line
resharper_csharp_accessor_owner_declaration_braces = end_of_line
resharper_csharp_accessor_declaration_braces = end_of_line
resharper_csharp_case_block_braces = end_of_line
resharper_csharp_initializer_braces = end_of_line
resharper_csharp_other_braces = end_of_line

#### ReSharper ####

# Stops Rider and `jb cleanupcode` wrapping parameter and argument lists.
resharper_csharp_max_line_length = 1000
resharper_csharp_wrap_lines = false

# The two conventions no rule expresses: parameter lists, constructor arguments and record
# definitions stay on one line when practical, and deliberate one-liners such as
# `try { SqliteConnection.ClearPool(sqlite); } catch { /* best effort */ }` stay intact.
# Every `keep_existing` switch below is what makes cleanup leave hand-tuned layout alone.
resharper_csharp_keep_existing_linebreaks = true
resharper_csharp_keep_existing_declaration_parens_arrangement = true
resharper_csharp_keep_existing_invocation_parens_arrangement = true
resharper_csharp_keep_existing_declaration_block_arrangement = true
resharper_csharp_keep_existing_embedded_block_arrangement = true
resharper_csharp_keep_existing_embedded_arrangement = true
resharper_csharp_keep_existing_initializer_arrangement = true
resharper_csharp_keep_existing_attribute_arrangement = true
resharper_csharp_keep_existing_expr_member_arrangement = true
resharper_csharp_keep_existing_switch_expression_arrangement = true
resharper_csharp_keep_existing_property_patterns_arrangement = true
resharper_csharp_keep_existing_list_patterns_arrangement = true

# Do NOT add `resharper_substitution_for_cleanup_profile` here. It silently turns cleanup into a
# no-op: `jb` reports the profile it is using, exits 0, and changes nothing. `build/cleanup.sh`
# passes `--profile` on the command line instead.

#### Test projects ####

# Test names are underscore-separated.
[tests/**/*.cs]
dotnet_diagnostic.IDE1006.severity = none
